# GitHub Webhook Handler Configuration
# Copy this file to .env and fill in your values

# Server port (default: 3000)
PORT=3000

# Repository owner to index (default: augment-solutions)
REPO_OWNER=augment-solutions

# Branch to trigger indexing on (default: main)
TARGET_BRANCH=main

# Comma-separated list of allowed repositories (leave empty to allow all)
ALLOWED_REPOS=repo1,repo2,repo3

# GitHub webhook secret for signature verification
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET=your-webhook-secret

# GitHub token for accessing repositories
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-token

# Augment API credentials
AUGMENT_API_TOKEN=your-augment-api-token
AUGMENT_API_URL=https://your-tenant.api.augmentcode.com/
